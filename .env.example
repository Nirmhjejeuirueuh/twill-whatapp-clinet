# Twilio Configuration
# You can either set these environment variables or enter them in the app settings

# Your Twilio Account SID (starts with AC)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp-enabled phone number (without whatsapp: prefix)
TWILIO_WHATSAPP_NUMBER=14155238886

# For the sandbox, use: +14155238886
# For production, use your own Twilio WhatsApp number

# Vercel Blob Token (get from Vercel dashboard)
BLOB_READ_WRITE_TOKEN=your_blob_token_here